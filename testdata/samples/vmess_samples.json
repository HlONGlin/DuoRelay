# VMess Sample Collection

## Protocol: VMess

### Sample 1: Basic TCP
```json
{
  "name": "vmess-tcp",
  "format": "uri",
  "link": "vmess://eyJ2IjoiMiIsInBzIjoiVGVzdC1WTWVzcyIsImFkZCI6ImV4YW1wbGUuY29tIiwicG9ydCI6IjQ0MyIsImlkIjoiYjhjYTU3YzItZWIzOS00OTFhLTg0MjUtYmJhODI4ZmJhZDJkIiwiYWlkIjoiMCIsInNjeSI6ImF1dG8iLCJuZXQiOiJ0Y3AiLCJ0eXBlIjoibm9uZSIsImhvc3QiOiIiLCJwYXRoIjoiIiwidGxzIjoidGxzIiwic25pIjoiIiwiYWxwbiI6IiJ9",
  "description": "VMess over TCP with TLS",
  "expected_ir": {
    "protocol": "vmess",
    "name": "Test-VMess",
    "server": {
      "host": "example.com",
      "port": 443
    },
    "security": {
      "type": "tls"
    },
    "proto": {
      "uuid": "b8ca57c2-eb39-491a-8425-bba828fbad2d",
      "alter_id": 0,
      "security": "auto"
    }
  }
}
```

### Sample 2: WebSocket
```json
{
  "name": "vmess-ws",
  "format": "uri",
  "link": "vmess:",
  "description": "VMess over WebSocket with TLS",
  "expected_ir": {
    "protocol": "vmess",
    "name": "VMess-WS",
    "server": {
      "host": "ws.example.com",
      "port": 443
    },
    "transport": {
      "type": "ws",
      "path": "/vmess",
      "host": "ws.example.com"
    },
    "security": {
      "type": "tls",
      "sni": "ws.example.com"
    },
    "proto": {
      "uuid": "b8ca57c2-eb39-491a-8425-bba828fbad2d",
      "alter_id": 0,
      "security": "auto"
    }
  }
}
```

### Sample 3: gRPC
```json
{
  "name": "vmess-grpc",
  "format": "uri",
  "link": "vmess:",
  "description": "VMess over gRPC with TLS",
  "expected_ir": {
    "protocol": "vmess",
    "name": "VMess-gRPC",
    "server": {
      "host": "grpc.example.com",
      "port": 443
    },
    "transport": {
      "type": "grpc",
      "service_name": "vmess-grpc"
    },
    "security": {
      "type": "tls",
      "sni": "grpc.example.com"
    },
    "proto": {
      "uuid": "b8ca57c2-eb39-491a-8425-bba828fbad2d",
      "alter_id": 0,
      "security": "auto"
    }
  }
}
```
