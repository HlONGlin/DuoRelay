[Unit]
Description=DuoRelay proxy manager
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=@DUORELAY_USER@
Group=@DUORELAY_USER@
WorkingDirectory=@DUORELAY_PREFIX@
StateDirectory=duorelay
StateDirectoryMode=0750
ExecStart=@DUORELAY_PREFIX@/duorelay --listen 127.0.0.1:8080 --db ${STATE_DIRECTORY}/duorelay.db --config-dir ${STATE_DIRECTORY}/configs --kernels @DUORELAY_PREFIX@/kernels
Restart=on-failure
RestartSec=15
TimeoutStopSec=20
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@DUORELAY_DATA@
PrivateTmp=true

[Install]
WantedBy=multi-user.target
