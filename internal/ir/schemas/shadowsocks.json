{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Shadowsocks Protocol Fields",
  "description": "Protocol-specific fields for Shadowsocks nodes",
  "type": "object",
  "required": ["method", "password"],
  "properties": {
    "method": {
      "type": "string",
      "description": "Encryption method",
      "enum": [
        "aes-128-gcm",
        "aes-192-gcm",
        "aes-256-gcm",
        "chacha20-ietf-poly1305",
        "xchacha20-ietf-poly1305",
        "2022-blake3-aes-128-gcm",
        "2022-blake3-aes-256-gcm",
        "2022-blake3-chacha20-poly1305",
        "none",
        "plain"
      ]
    },
    "password": {
      "type": "string",
      "description": "Password for authentication",
      "minLength": 1
    },
    "plugin": {
      "type": "string",
      "description": "Plugin name (e.g., obfs-local, v2ray-plugin)",
      "examples": ["obfs-local", "v2ray-plugin", "simple-obfs"]
    },
    "plugin_opts": {
      "type": "string",
      "description": "Plugin options as semicolon-separated string"
    },
    "udp": {
      "type": "boolean",
      "description": "Enable UDP relay",
      "default": true
    },
    "udp_over_tcp": {
      "type": "boolean",
      "description": "Enable UDP over TCP relay"
    }
  },
  "additionalProperties": false
}
